# Copy to `.env` and adjust for your environment.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_PATH=/app/data/db.sqlite3
API_PAGE_SIZE=10
GUNICORN_WORKERS=3

# PostgreSQL (used when DJANGO_DB_ENGINE=postgres)
POSTGRES_DB=school_rasool
POSTGRES_USER=school_rasool
POSTGRES_PASSWORD=school_rasool_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (for local dev / browser access)
CORS_ALLOW_ALL_ORIGINS=true
# Comma-separated list (used when `CORS_ALLOW_ALL_ORIGINS=false`)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

